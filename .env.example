# Optional. Cloud sync (user accounts, cross-device progress) is entirely
# optional — the app is fully functional in guest/offline mode with none of
# these set. See docs/SUPABASE_SETUP.md for how to create a project and
# fill these in.
#
# Only the public anon key belongs here — never a service-role key. Row
# Level Security (see supabase/schema.sql) is what keeps that key safe to
# ship to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
